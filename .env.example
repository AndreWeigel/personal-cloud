# ============================================================
# .env.example — copy this to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# --- Vaultwarden ---
# Generate with: openssl rand -base64 48
ADMIN_TOKEN=change-me-generate-with-openssl-rand-base64-48

# --- Nextcloud Database ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# --- Nextcloud ---
NEXTCLOUD_TRUSTED_DOMAINS=cloud.yourdomain.com

# --- Server ---
DOMAIN=yourdomain.com
SERVER_IP=0.0.0.0

# --- Hetzner Storage Box (for Nextcloud external storage) ---
STORAGE_BOX_USER=uXXXXXX
STORAGE_BOX_HOST=uXXXXXX.your-storagebox.de

# --- Immich ---
UPLOAD_LOCATION=./data/upload
DB_DATA_LOCATION=./data/postgres
DB_PASSWORD=change-me
DB_USERNAME=immich
DB_DATABASE_NAME=immich
# IMMICH_VERSION=release  # pin to a specific version if needed

# --- Firefly III (finance.yourdomain.com) ---
# APP_KEY must be EXACTLY 32 characters. Generate with:
#   head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32; echo
FIREFLY_APP_KEY=change-me-exactly-32-characters!
FIREFLY_SITE_OWNER=you@example.com
FIREFLY_DB_DATABASE=firefly
FIREFLY_DB_USERNAME=firefly
FIREFLY_DB_PASSWORD=change-me
# 32-char token for the cron sidecar. Generate the same way as APP_KEY.
STATIC_CRON_TOKEN=change-me-exactly-32-characters!

# --- Firefly Data Importer (import.yourdomain.com) ---
# Personal Access Token from Firefly: Options > Profile > OAuth >
# Personal Access Tokens. Created AFTER first login — leave blank on first
# deploy, fill it in, then re-run: cd ~/firefly && docker compose up -d
FIREFLY_PAT=
# GoCardless / Nordigen Bank Account Data credentials (N26 = Germany)
NORDIGEN_ID=change-me
NORDIGEN_KEY=change-me
# Shared secret protecting the automated import endpoint. Generate with:
#   openssl rand -hex 16
AUTO_IMPORT_SECRET=change-me
